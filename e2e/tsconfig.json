{
  "extends": "../frontend/tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // 準備の script（node で直接流す）が src/ の .ts を拡張子つきで読むため。E2E は出力しない（noEmit は共通の設定）
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "showcase",
    "docs",
    "playwright.config.ts",
    "playwright.showcase.config.ts",
    "playwright.docs.config.ts"
  ]
}
