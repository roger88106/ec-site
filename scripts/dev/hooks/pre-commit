#!/usr/bin/env bash
# ============================================================================
# commit の前に、CI の検査の script（scripts/ci/check-all.sh）を流す（CI の検査）
#
# 置き方（開発環境の起動）：.git/hooks/pre-commit に、この script を呼ぶ 1 行を書く。
# core.hooksPath は使わない（各自が .git/hooks/ に置いた hook と並べられるように）。
# テスト（バックエンド・画面・E2E）は時間がかかるので流さない。
# 検査するのは、ステージした内容（次の commit）だけ。ステージした内容を一時ディレクトリに取り出し、そこで検査する。
# 処理は scripts/dev/lib/pre-commit.mjs（テストのため）。この script は、入口の pre-commit-main.mjs を呼ぶだけ。
# 作業ツリーは変えない（stash で退避して戻すと、一部だけをステージしたファイルで戻すときに衝突するため）。
# 関連 spec の照合（commit のメッセージが要る）は commit-msg の hook で行う。
# ============================================================================
ROOT="$(git rev-parse --show-toplevel)"
# 検査は、この hook と同じ bash で実行する（node が PATH から bash を探すと、Windows では WSL の bash.exe を引くことがある）。
# Git Bash の $BASH は /usr/bin/bash の形なので、node が開けるよう cygpath で Windows のパスにする
PRE_COMMIT_BASH="${BASH:-$(command -v bash)}"
if command -v cygpath >/dev/null 2>&1; then
  PRE_COMMIT_BASH="$(cygpath -m "$PRE_COMMIT_BASH")"
fi
export PRE_COMMIT_BASH
exec node "$ROOT/scripts/dev/lib/pre-commit-main.mjs"
