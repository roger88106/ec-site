// 入力の制約（maxLength・minLength・max・min）に数字を直接書かず、API の契約から書き出した定数（src/api/generated/constraints.ts）を使う（フロントの書き方の「入力の制約は契約から書き出した定数」）。
language js

JsxAttribute(name=r"maxLength|minLength|max|min", initializer=$value) as $attr where {
  $value <: r"(?s)=\s*(?:\{\s*-?\d|\"-?\d).*",
  register_diagnostic(span=$attr, message="入力の制約に数字を直接書かず、API の契約から書き出した定数（src/api/generated/constraints.ts）を使う（フロントの書き方の「入力の制約は契約から書き出した定数」）。", severity="error")
}
