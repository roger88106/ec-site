#!/usr/bin/env bash
# ============================================================================
# commit のメッセージを書いた後に、次の commit の関連 spec を照合する（CI の検査）
#
# 置き方（開発環境の起動）：.git/hooks/commit-msg に、この script を呼ぶ 1 行を書く（メッセージのファイルを渡す）。
# pre-commit の時点ではメッセージがないので、ステージした設計の文書とメッセージの 1 行目のタスク番号は、ここで照合する。
# commit の履歴の照合は、pre-commit の hook と CI が行う。
# ============================================================================
ROOT="$(git rev-parse --show-toplevel)"
exec node "$ROOT/scripts/ci/related-specs.mjs" --staged "$1"
