#!/usr/bin/env bash
# ============================================================================
# commit の前に、CI の検査の script（scripts/ci/check-all.sh）を流す（CI の検査）
#
# 置き方（開発環境の起動）：.git/hooks/pre-commit に、この script を呼ぶ 1 行を書く。
# core.hooksPath は使わない（各自が .git/hooks/ に置いた hook と並べられるように）。
# テスト（バックエンド・画面・E2E）は時間がかかるので流さない。
# ============================================================================
ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/ci/check-all.sh"
