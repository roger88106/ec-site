// テストで環境変数を変えるときは vi.stubEnv を使い、process.env に代入しない（フロントのテストの書き方の「環境変数は vi.stubEnv で変える」）。
// 見る形は、プロパティへの代入（+= などを含む）、process.env そのものへの代入、delete、Object.assign。別の変数を経由した代入は追わない。
language js

or {
  JsAssignmentExpression(left=$target) as $write where {
    $target <: or { JsStaticMemberAssignment(object=$env), JsComputedMemberAssignment(object=$env) },
    $env <: `process.env`
  },
  `process.env = $_` as $write,
  `delete process.env.$_` as $write,
  `delete process.env[$_]` as $write,
  `Object.assign(process.env, $_)` as $write
} where {
  register_diagnostic(span=$write, message="process.env に代入せず、vi.stubEnv で変える（フロントのテストの書き方の「環境変数は vi.stubEnv で変える」）。", severity="error")
}
