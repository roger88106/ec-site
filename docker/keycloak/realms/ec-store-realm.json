{
  "realm": "ec-store",
  "displayName": "EC Site",
  "enabled": true,
  "loginTheme": "ec-site",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(8) and maxLength(64) and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": ["ja"],
  "defaultLocale": "ja",
  "localizationTexts": {
    "ja": {
      "birthdate": "生年月日",
      "gender": "性別",
      "gender.male": "男性",
      "gender.female": "女性",
      "gender.other": "その他",
      "gender.undisclosed": "回答しない"
    }
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"birthdate\",\"displayName\":\"${birthdate}\",\"validations\":{\"iso-date\":{}},\"annotations\":{\"inputType\":\"html5-date\",\"inputTypeMin\":\"1900-01-01\"},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"gender\",\"displayName\":\"${gender}\",\"validations\":{\"options\":{\"options\":[\"male\",\"female\",\"other\",\"undisclosed\"]}},\"annotations\":{\"inputType\":\"select\",\"inputOptionLabels\":{\"male\":\"${gender.male}\",\"female\":\"${gender.female}\",\"other\":\"${gender.other}\",\"undisclosed\":\"${gender.undisclosed}\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@ec-site.example",
    "fromDisplayName": "EC Site"
  },
  "clients": [
    {
      "clientId": "ec-store-web",
      "name": "店舗画面",
      "baseUrl": "http://localhost:3000/",
      "enabled": true,
      "publicClient": false,
      "secret": "ec-store-web-local-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3100/*", "http://localhost:13000/*", "http://localhost:23000/*", "http://localhost:33000/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3100", "http://localhost:13000", "http://localhost:23000", "http://localhost:33000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3100/*##http://localhost:13000/*##http://localhost:23000/*##http://localhost:33000/*"
      },
      "protocolMappers": [
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birthdate",
            "claim.name": "birthdate",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "gender",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "gender",
            "claim.name": "gender",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-ec-store-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ec-store-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ec-store-api",
      "name": "店舗 API（token の audience）",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000009001",
      "username": "member@example.com",
      "email": "member@example.com",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["default-roles-ec-store"],
      "firstName": "太郎",
      "lastName": "会員",
      "attributes": {
        "birthdate": ["1990-05-20"],
        "gender": ["male"]
      },
      "credentials": [
        { "type": "password", "value": "member-pass-1", "temporary": false }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000009002",
      "username": "member2@example.com",
      "email": "member2@example.com",
      "emailVerified": true,
      "enabled": true,
      "realmRoles": ["default-roles-ec-store"],
      "firstName": "花子",
      "lastName": "会員",
      "credentials": [
        { "type": "password", "value": "member2-pass-1", "temporary": false }
      ]
    }
  ]
}
