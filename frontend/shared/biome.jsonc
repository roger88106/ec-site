{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  // 共通の設定（整形、lint の規則、shadcn/ui の生成物の扱い）
  "extends": ["../biome.base.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    // .gitignore はリポジトリのルートにある
    "root": "../..",
    "useIgnoreFile": true
  }
}
