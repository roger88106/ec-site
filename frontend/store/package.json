{
  "name": "ec-site-store",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../api/openapi/store.yaml -o src/api/generated/store.ts --enum-values && node ../shared/scripts/export-constraints.mjs ../../api/openapi/store.yaml src/api/generated/constraints.ts",
    "dev": "pnpm generate:api && next dev",
    "build": "pnpm generate:api && next build",
    "start": "next start",
    "typecheck": "pnpm generate:api && next typegen && tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ec-site/shared": "workspace:*",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "openapi-msw": "^2.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
