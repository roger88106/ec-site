{
  "name": "ec-site-admin",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../../api/openapi/admin.yaml -o src/api/generated/admin.ts --enum-values && node ../shared/scripts/export-constraints.mjs ../../api/openapi/admin.yaml src/api/generated/constraints.ts",
    "dev": "pnpm generate:api && vite",
    "build": "pnpm generate:api && tsc -b && vite build",
    "typecheck": "pnpm generate:api && tsc -b",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "test": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@ec-site/shared": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.89.0",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "openapi-msw": "^2.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
