{
  "name": "ec-site-e2e",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../api/openapi/admin.yaml -o src/generated/admin.ts --enum-values",
    "test": "node scripts/run.ts",
    "typecheck": "pnpm generate:api && tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "capture": "playwright test -c playwright.showcase.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2"
  }
}
