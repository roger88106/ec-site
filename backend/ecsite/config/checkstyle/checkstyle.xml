<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  確認するのは次の 3 つの種類だけ。
  ・Javadoc の書き漏れ（コメントの書き方の「Java」）。対象は private を含むすべてのクラス・メソッド・コンストラクタ・項目。
    上書き（@Override）は除く（MissingJavadocMethod の既定）。Javadoc があるかだけを見て、@param・@return の有無と中身は見ない。
    main だけに適用し、test などは suppressions.xml で抑える。
  ・import：使われていないもの、* の import、並び（バックエンドの書き方の「書式」）。全てのソースセットに適用する。
    並びは、java・javax 以外、java・javax、static の順で、まとまりの間は空行 1 行、まとまりの中は文字コードの順。
  ・使わない注釈（バックエンドの書き方の「null の扱い」）。import と、完全修飾名で書いた注釈を見る（コメントの中は見ない）。
    JSpecify（org.jspecify.annotations）以外の Nullable は、全てのソースセットに適用する。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="THIRD_PARTY_PACKAGE###STANDARD_JAVA_PACKAGE###STATIC"/>
            <property name="separateLineBetweenGroups" value="true"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
        </module>
        <module name="MissingJavadocType">
            <property name="scope" value="private"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="private"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
        </module>
        <module name="JavadocVariable"/>
        <!-- NullAway が見る注釈をそろえる -->
        <module name="IllegalImport">
            <property name="id" value="otherNullable"/>
            <property name="regexp" value="true"/>
            <property name="illegalClasses" value="^(?!org\.jspecify\.annotations\.)[\w.]+\.Nullable$"/>
            <message key="import.illegal" value="Nullable は org.jspecify.annotations.Nullable を使う: {0}"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="otherNullable"/>
            <property name="format" value="@\s*(?!org\.jspecify\.annotations\.)(?:[a-z]\w*\.)+Nullable\b"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Nullable は org.jspecify.annotations.Nullable を使う"/>
        </module>
    </module>
</module>
