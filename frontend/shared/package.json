{
  "name": "@ec-site/shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "管理画面と店舗画面で共有する処理・部品・テーマ。TypeScript のソースのまま使い、ビルドしない（フロントの書き方 第 5 節）",
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./ui/*": "./src/ui/*.tsx",
    "./messages/*": "./src/messages/*",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "use-intl": "^4.14.9"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.5",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
