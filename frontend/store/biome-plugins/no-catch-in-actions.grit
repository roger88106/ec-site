// サーバーアクションでは catch を書かず、withActionResult で包む（フロントの書き方の「サーバーアクションは withActionResult で包む」）。
// catch で Next.js の redirect・notFound を飲み込むと、ログイン画面への移動などが通信の失敗に見えてしまう。
// biome.jsonc の overrides で、src/actions/ だけに当てる（withActionResult.ts は除く）。
language js

JsCatchClause() as $catch where {
  register_diagnostic(span=$catch, message="サーバーアクションでは catch を書かず、withActionResult で包む（フロントの書き方の「サーバーアクションは withActionResult で包む」）。", severity="error")
}
