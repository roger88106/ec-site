// 読み上げの領域は status の役割（role="status"）で作り、aria-live を直接書かない（フロントの書き方 第 10.2 節）。
// 読み上げない領域の aria-live="off" だけは書いてよい。
// 見るのは JSX の属性の直書きだけで、スプレッド（{...props}）で渡された aria-live は見ない。
// biome.jsonc の overrides で、テスト以外の src/ に当てる。
language js

JsxAttribute() as $attr where {
  $attr <: r"(?s)aria-live.*",
  not $attr <: r"aria-live=[{]?[\"'`]off[\"'`][}]?",
  register_diagnostic(span=$attr, message="aria-live を直接書かず、読み上げの領域は role=status で作る。読み上げない領域だけ aria-live=off と書ける（フロントの書き方 第 10.2 節）。", severity="error")
}
